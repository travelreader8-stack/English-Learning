      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "第一，过去计划里的未来："
        },
        {
          "lang": "en",
          "text": "This platform would serve as a port and a railway station"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 86,
      "start": 554.534,
      "end": 564.313,
      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
