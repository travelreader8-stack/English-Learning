      "i": 78,
      "start": 410.108,
      "end": 414.788,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "insist"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "如果你 insist on joining someone who wants to be alone，这就不够尊重。"
        }
      ]
    },
    {
      "i": 79,
      "start": 415.138,
      "end": 418.218,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "insist"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "所以今天学的不只是词义，还有边界感。"
        }
      ]
    },
    {
      "i": 80,
      "start": 418.568,
      "end": 425.888,
      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "今天的语法从一个社交场景开始：Elizabeth 想避开、想假装、想阻止 Nigel 跟着。"
