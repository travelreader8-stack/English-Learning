    {
      "i": 60,
      "start": 320.992,
      "end": 323.776,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "persistent"
      },
      "segments": [
        {
          "lang": "en",
          "text": "Persistent"
        },
        {
          "lang": "zh",
          "text": "有两面。"
        }
      ]
    },
    {
      "i": 61,
      "start": 324.125,
      "end": 329.925,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "persistent"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "好的一面是坚持不懈，比如 persistent practice, persistent study。"
        }
      ]
    },
    {
      "i": 62,
      "start": 330.275,
      "end": 336.355,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "persistent"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "不好的一面是纠缠不休，别人已经需要空间了，你还不停推进。"
        }
      ]
    },
    {
      "i": 63,
      "start": 336.705,
      "end": 342.369,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "persistent"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "这一课的标题"
        },
        {
          "lang": "en",
          "text": "Persistent"
        },
        {
          "lang": "zh",
          "text": "用的是让人尴尬的那一面。"
        }
      ]
    },
    {
      "i": 64,
      "start": 342.719,
      "end": 350.999,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "persistent"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "记住判断标准：坚持用在自己的目标上，可能是优点；坚持压到别人身上，就可能是打扰。"
        }
      ]
    },
    {
      "i": 65,
      "start": 351.349,
      "end": 354.197,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "avoid"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "第二组词："
        },
        {
          "lang": "en",
          "text": "avoid"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
