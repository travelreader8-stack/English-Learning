        {
          "lang": "zh",
          "text": "，"
        },
        {
          "lang": "en",
          "text": "a great deal of excitement"
        },
        {
          "lang": "zh",
          "text": "，"
        },
        {
          "lang": "en",
          "text": "a great many loud explosions"
        },
        {
          "lang": "zh",
          "text": "，"
        },
        {
          "lang": "en",
          "text": "many of the cars"
