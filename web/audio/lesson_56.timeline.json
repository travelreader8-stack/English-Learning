      "i": 107,
      "start": 721.423,
      "end": 730.047,
      "speaker": "A",
      "scene": "you_too",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "再说参加人数和气氛："
        },
        {
          "lang": "en",
          "text": "A lot of children entered for this race"
        },
        {
          "lang": "zh",
          "text": "，而且"
        },
        {
          "lang": "en",
          "text": "there was a great deal of excitement"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 108,
      "start": 730.397,
      "end": 735.309,
      "speaker": "A",
      "scene": "you_too",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "中间出现小状况："
