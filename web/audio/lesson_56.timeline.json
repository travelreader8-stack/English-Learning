    },
    {
      "i": 66,
      "start": 473.258,
      "end": 476.834,
      "speaker": "B",
      "scene": "passage_normal",
      "scene_meta": {},
      "segments": [
        {
          "lang": "en",
          "text": "A few cars, however, completed the race."
        }
      ]
    },
    {
