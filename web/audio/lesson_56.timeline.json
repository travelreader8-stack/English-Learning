    {
      "i": 55,
      "start": 388.328,
      "end": 391.221,
      "speaker": "B",
      "scene": "discuss",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "这篇数量词为什么这么多？"
