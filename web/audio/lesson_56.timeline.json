      "start": 488.707,
      "end": 492.043,
      "speaker": "B",
      "scene": "passage_normal",
      "scene_meta": {},
      "segments": [
        {
          "lang": "en",
          "text": "The race gave everyone a great deal of pleasure."
        }
      ]
    },
