      },
      "segments": [
        {
          "lang": "en",
          "text": "Detect"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 81,
      "start": 570.203,
      "end": 575.995,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "detect"
      },
      "segments": [
        {
          "lang": "en",
          "text": "Detect"
        },
        {
          "lang": "zh",
          "text": "是发现、探测到不容易直接看见的东西。"
        }
      ]
    },
    {
      "i": 82,
      "start": 576.345,
      "end": 580.921,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "detect"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "课文说机器"
        },
        {
          "lang": "en",
          "text": "has been used to detect gold"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 83,
      "start": 581.27,
      "end": 587.63,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "detect"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "生活里也可以说："
        },
        {
          "lang": "en",
          "text": "A sensor can detect movement"
        },
        {
          "lang": "zh",
          "text": "，传感器能探测到移动。"
        }
      ]
    },
    {
      "i": 84,
      "start": 587.98,
      "end": 594.26,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "detect"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "在这课里，detect 把机器和地下金子连起来，让寻宝期待突然变高。"
        }
      ]
    },
    {
      "i": 85,
      "start": 594.61,
      "end": 597.602,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "worthless"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "第三个词："
        },
        {
          "lang": "en",
          "text": "worthless"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
