      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "因为重点是国会大厦和大钟这些公共项目被建起来，而不是具体哪个工人砌了哪块石头。"
        }
      ]
    },
