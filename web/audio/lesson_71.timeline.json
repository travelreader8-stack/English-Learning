      "end": 503.547,
      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "第三个重点是"
        },
        {
          "lang": "en",
          "text": "have something done"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
