      "end": 491.767,
      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "第二个重点是 passive。课文有"
        },
        {
          "lang": "en",
          "text": "would never have been erected"
        },
        {
          "lang": "zh",
          "text": "，还有"
        },
        {
          "lang": "en",
          "text": "were being built"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
