      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "中文意思是：如果 1834 年那场火没有发生，这座大钟就不会被建起来。"
        }
      ]
    },
    {
      "i": 75,
      "start": 465.0,
      "end": 474.184,
      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "en",
          "text": "Had not been burned down"
        },
        {
          "lang": "zh",
          "text": "是过去没有被烧毁；"
        },
        {
          "lang": "en",
          "text": "would never have been erected"
        },
        {
          "lang": "zh",
          "text": "是后来就永远不会被建起来。"
        }
