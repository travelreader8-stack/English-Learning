      "scene": "vocab",
      "scene_meta": {
        "word": "hitchhike"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "我们学习这个旧故事里的词，但安全规则很简单：儿童不要搭陌生人的车。"
