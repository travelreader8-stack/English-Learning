      ]
    },
    {
      "i": 73,
      "start": 465.358,
      "end": 469.109,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "income"
      },
      "segments": [
        {
          "lang": "en",
          "text": "Income"
        },
        {
