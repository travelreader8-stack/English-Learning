        }
      ]
    },
    {
      "i": 24,
      "start": 139.03,
      "end": 144.742,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "2"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "训练看起来非常成功："
        },
        {
          "lang": "en",
          "text": "Rex soon became an expert at opening the gate"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 25,
      "start": 145.092,
      "end": 149.852,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "2"
