        }
      ]
    },
    {
      "i": 74,
      "start": 418.774,
      "end": 422.054,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "bark"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "原来 Rex bark，是想 come into the garden。"
        }
      ]
    },
    {
      "i": 75,
      "start": 422.404,
      "end": 425.604,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "bark"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "后来 Rex bark，是想让 someone let him out。"
        }
      ]
    },
