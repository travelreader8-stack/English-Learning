      "start": 127.149,
      "end": 130.389,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "2"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "Rex 用 paw 按住 latch，门就能打开。"
