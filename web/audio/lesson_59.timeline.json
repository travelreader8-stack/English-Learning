      "i": 30,
      "start": 173.742,
      "end": 178.661,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "3"
      },
      "segments": [
        {
          "lang": "en",
          "text": "Notice"
        },
        {
          "lang": "zh",
          "text": "是“注意到、发现”，不是特意去找。"
        }
      ]
