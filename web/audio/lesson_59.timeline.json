      "i": 23,
      "start": 134.489,
      "end": 138.681,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "2"
      },
      "segments": [
        {
          "lang": "en",
          "text": "Himself"
        },
        {
          "lang": "zh",
