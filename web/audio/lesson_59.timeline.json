          "text": "有时候，大人想训练宠物解决一个"
        },
        {
          "lang": "en",
          "text": "problem"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 1,
      "start": 5.166,
      "end": 10.742,
      "speaker": "A",
      "scene": "hook",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "可是宠物太聪明，反而把办法玩成了新"
        },
        {
          "lang": "en",
          "text": "problem"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
