          "lang": "zh",
          "text": "第二帧，看聪明办法。"
        }
      ]
    },
    {
      "i": 16,
      "start": 95.08,
      "end": 103.704,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "2"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "中文锚点是：丈夫花了几周训练 Rex，用"
        },
        {
