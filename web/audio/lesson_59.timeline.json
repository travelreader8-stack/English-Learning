      "start": 502.374,
      "end": 505.854,
      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "它告诉我们，这是 Rex 以前常做的事。"
        }
      ]
    },
    {
