      "start": 506.204,
      "end": 510.583,
      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "第二块："
        },
        {
          "lang": "en",
          "text": "would"
        },
