          "lang": "zh",
          "text": "按"
        },
        {
          "lang": "en",
          "text": "latch"
        },
        {
          "lang": "zh",
          "text": "，让它自己进来。"
        }
      ]
    },
    {
      "i": 17,
      "start": 104.054,
      "end": 107.874,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "2"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "课文说："
        },
        {
          "lang": "en",
          "text": "my husband spent weeks training him"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 18,
      "start": 108.224,
      "end": 115.32,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "2"
      },
      "segments": [
        {
          "lang": "en",
          "text": "Spend weeks training him"
        },
        {
          "lang": "zh",
          "text": "就是花了几个星期训练它，说明这不是一下子就学会的。"
        }
      ]
    },
