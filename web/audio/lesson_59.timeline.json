          "text": "第三帧记住：old problem 是"
        },
        {
          "lang": "en",
          "text": "let himself in"
        },
        {
          "lang": "zh",
          "text": "，new problem 是"
        },
        {
          "lang": "en",
          "text": "let him out"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
