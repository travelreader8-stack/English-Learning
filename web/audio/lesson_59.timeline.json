          "text": "Rex 原来在门外"
        },
        {
          "lang": "en",
          "text": "barking"
        },
        {
          "lang": "zh",
          "text": "，因为它想进花园。"
        }
      ]
    },
    {
      "i": 3,
      "start": 16.721,
      "end": 21.993,
      "speaker": "A",
      "scene": "hook",
      "scene_meta": {},
      "segments": [
        {
