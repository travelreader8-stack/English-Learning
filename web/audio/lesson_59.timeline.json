      "start": 420.131,
      "end": 423.411,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "bark"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "原来 Rex bark，是想 come into the garden。"
        }
      ]
    },
