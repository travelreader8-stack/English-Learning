      "start": 87.301,
      "end": 91.801,
      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "1"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "第一帧记住：Rex 想进来，所以在门外一直叫。"
        }
      ]
    },
