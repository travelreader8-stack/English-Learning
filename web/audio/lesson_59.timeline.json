      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "第一块："
        },
        {
          "lang": "en",
          "text": "used to"
        },
        {
          "lang": "zh",
          "text": "，过去常常。"
        }
      ]
    },
    {
      "i": 92,
      "start": 497.064,
      "end": 502.024,
      "speaker": "A",
      "scene": "grammar",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "例句是："
        },
        {
          "lang": "en",
          "text": "Rex used to sit outside our front gate and bark"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
