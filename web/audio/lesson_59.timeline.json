      "i": 75,
      "start": 423.761,
      "end": 426.961,
      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "bark"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "后来 Rex bark，是想让 someone let him out。"
        }
      ]
    },
