      "speaker": "A",
      "scene": "vocab",
      "scene_meta": {
        "word": "habit"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "Rex 的 bad habit 是：开门进来，等门关，叫人放出去，再马上进来。"
        }
      ]
    },
