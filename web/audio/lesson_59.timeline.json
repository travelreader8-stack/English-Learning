          "text": "主人训练它自己开门，结果 Rex really became"
        },
        {
          "lang": "en",
          "text": "an expert"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 4,
      "start": 22.343,
      "end": 28.151,
      "speaker": "A",
      "scene": "hook",
      "scene_meta": {},
      "segments": [
        {
          "lang": "zh",
          "text": "今天先抓住这个笑点："
        },
        {
          "lang": "en",
          "text": "he learned the trick, but he used it the wrong way"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
    },
    {
      "i": 5,
      "start": 28.501,
      "end": 31.301,
