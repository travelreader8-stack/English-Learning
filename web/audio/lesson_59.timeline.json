      "speaker": "A",
      "scene": "retell",
      "scene_meta": {
        "frame": "3"
      },
      "segments": [
        {
          "lang": "zh",
          "text": "课文说："
        },
        {
          "lang": "en",
          "text": "when I was going out shopping last week, I noticed him in the garden near the gate"
        },
        {
          "lang": "zh",
          "text": "。"
        }
      ]
